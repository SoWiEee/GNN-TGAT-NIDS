# Copy to .env and adjust for your environment

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Session cleanup
SESSION_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300

# Upload limits (bytes)
MAX_UPLOAD_BYTES=52428800

# Adversarial endpoint timeout (seconds)
ADV_TIMEOUT_SECONDS=30.0

# WebSocket streaming
WS_DEFAULT_WINDOW_SECONDS=60.0
WS_MAX_BUFFER_SIZE=10000
MAX_CONCURRENT_WS=5

# Inference concurrency (limits simultaneous GPU usage)
MAX_CONCURRENT_INFER=3

# Attack endpoints (set to false in production)
ENABLE_ATTACK_ENDPOINTS=true
